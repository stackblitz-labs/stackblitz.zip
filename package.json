{
  "name": "stackblitz-zip",
  "type": "module",
  "version": "0.0.8",
  "packageManager": "pnpm@11.1.2",
  "description": "Download StackBlitz projects programmatically",
  "license": "MIT",
  "repository": "stackblitz-labs/stackblitz.zip",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "bin": {
    "stackblitz-zip": "./dist/cli/zip.mjs",
    "stackblitz-clone": "./dist/cli/clone.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "lint": "eslint .",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm test",
    "publish:alias": "node scripts/publish-alias.js",
    "release": "bumpp",
    "test": "pnpm test:unit && pnpm test:types",
    "test:unit": "vitest",
    "test:knip": "knip",
    "test:versions": "installed-check -d",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "client-zip": "^2.4.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.7",
    "bumpp": "^10.3.1",
    "changelogithub": "^13.16.1",
    "eslint": "^9.39.1",
    "installed-check": "^9.3.0",
    "knip": "^5.67.1",
    "lint-staged": "^16.2.6",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.3",
    "unzipit": "^1.4.3",
    "vitest": "^4.0.7"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,md,yml,*rc}": [
      "npx eslint --fix"
    ]
  }
}
